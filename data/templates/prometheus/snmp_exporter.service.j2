[Unit]
Description=Prometheus exporter for SNMP-enabled devices
Documentation=https://github.com/prometheus/snmp_exporter
After=network.target

[Service]
Restart=on-failure
ExecStart=/usr/bin/snmp_exporter  \
{% if listen_address is vyos_defined %}
{%     for address in listen_address %}
        --web.listen-address={{ address }}:{{ port }} \
{%     endfor %}
{% else %}
        --web.listen-address=:{{ port }} \
{% endif %}
        --config.file=/etc/prometheus/snmp.yml

ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
