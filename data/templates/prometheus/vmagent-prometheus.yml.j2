global:
  scrape_interval: 15s
  scrape_timeout: 15s
{% if global_label is defined %}
  external_labels:
{%     for label_name, label_config in global_label.items() %}
    {{ label_name }}: {{ label_config.value }}
{%     endfor %}
{% endif %}


scrape_configs:
{% if job.node_exporter is defined %}
  # vyos node-exporter
  - job_name: "vyos-node-exporter"
    static_configs:
      - targets: ["{{ job.node_exporter.url }}"]
{% endif %}

{% if job.ping_exporter is defined %}
  # vyos ping-exporter
  - job_name: "vyos-ping-exporter"
    scrape_interval: {{ job.ping_exporter.scrape_interval }}
    scrape_timeout: {{ job.ping_exporter.scrape_interval }}
    static_configs:
      - targets: ["{{ job.ping_exporter.url }}"]
{% endif %}


{% if scrape_interval_list is defined %}
{%     for interval in scrape_interval_list %}
{%         if interval == "30s" %}
{%             set job_name = "snmp-exporter-BBone" %}
{%         elif interval == "1m" %}
{%             set job_name = "snmp-exporter-BBone-1minute" %}
{%         elif interval == "2m" %}
{%             set job_name = "snmp-exporter-BBone-2minute" %}
{%         elif interval == "3m" %}
{%             set job_name = "snmp-exporter-BBone-3minute" %}
{%         elif interval == "5m" %}
{%             set job_name = "snmp-exporter-BBone-5minute" %}
{%         else %}
{%             set job_name = "snmp-exporter-BBone-" ~ interval %}
{%         endif %}
  # vyos {{ job_name }}
  - job_name: "{{ job_name }}"
    scrape_interval: {{ interval }}
    scrape_timeout: {{ interval }}
    metrics_path: /snmp
    file_sd_configs:
    - files:
      - "/run/vmagent/*-file_sd_config-{{ interval }}.yml"
    relabel_configs:
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [auth]
        target_label: __param_auth
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9116
{%     endfor %}
{% endif %}
